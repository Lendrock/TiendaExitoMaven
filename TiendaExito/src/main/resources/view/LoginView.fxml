<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="fondo">

    <stylesheets>
        <URL value="@loginview.css" />
    </stylesheets>

    <VBox layoutX="100.0" layoutY="50.0" spacing="15.0" alignment="CENTER" prefWidth="400.0" prefHeight="300.0">
        <Label text="Iniciar Sesión" styleClass="titulo"/>

        <TextField promptText="Correo electrónico" styleClass="campo"/>

        <PasswordField promptText="Contraseña" styleClass="campo"/>

        <Button text="Ingresar" styleClass="boton"/>

        <Label text="¿No tienes cuenta?" styleClass="texto"/>
        <Hyperlink text="Regístrate aquí" styleClass="link"/>
    </VBox>

</AnchorPane>
