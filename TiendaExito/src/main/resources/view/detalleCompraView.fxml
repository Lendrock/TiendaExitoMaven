<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="800" stylesheets="@detallecompraview.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tiendaexito.controller.detalleCompraController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="111.0" spacing="15" styleClass="root1" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>
            <Button prefHeight="30.0" prefWidth="83.0" styleClass="boton-menu" text="NUEVO" />
            <Button prefHeight="30.0" prefWidth="84.0" styleClass="boton-menu" text="EDITAR" />
            <Button prefHeight="33.0" prefWidth="80.0" styleClass="boton-menu" text="ELIMINAR" />
            <Button onAction="#escenaPaginaInicio" prefHeight="36.0" prefWidth="81.0" styleClass="boton-menu" stylesheets="@productosview.css" text="REGRESAR" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" prefHeight="576.0" prefWidth="681.0" spacing="15" styleClass="root" stylesheets="@productosview.css" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label styleClass="titulo" text="Detalle Compra" />

            <TableView prefHeight="200" prefWidth="600" styleClass="tabla-detalleCompra">
                <columns>
                    <TableColumn text="ID" />
                    <TableColumn prefWidth="108.0" text="IDCompra" />
                    <TableColumn prefWidth="104.0" text="Producto" />
                    <TableColumn prefWidth="116.0" text="Cantidad" />
               <TableColumn prefWidth="136.0" text="Precio Unitario" />
               <TableColumn prefWidth="104.0" text="SubTotal" />
                </columns>
            </TableView>
         <GridPane prefHeight="163.0" prefWidth="649.0">
           <columnConstraints>
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="125.0" minWidth="10.0" prefWidth="92.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="221.0" minWidth="10.0" prefWidth="182.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="204.0" minWidth="10.0" prefWidth="95.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="209.0" minWidth="10.0" prefWidth="83.0" />
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="192.0" minWidth="10.0" prefWidth="192.0" />
           </columnConstraints>
           <rowConstraints>
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
           </rowConstraints>
            <children>
               <Label text="ID" textAlignment="RIGHT" />
               <Label text="IDCOMPRA" textAlignment="RIGHT" GridPane.rowIndex="1" />
               <Label text="IDPRODUCTO" textAlignment="RIGHT" GridPane.rowIndex="2" />
               <Label text="CANTIDAD" textAlignment="RIGHT" GridPane.rowIndex="3" />
               <Label text="PRECIO U" textAlignment="RIGHT" GridPane.columnIndex="3" />
               <Label text="SUBTOTAL" textAlignment="RIGHT" GridPane.columnIndex="3" GridPane.rowIndex="1" />
               <TextField prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="1" />
               <TextField prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <TextField prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="4" />
               <TextField prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="4" GridPane.rowIndex="1" />
               <ComboBox prefHeight="25.0" prefWidth="192.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <ComboBox prefHeight="25.0" prefWidth="185.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <TextField prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="4" GridPane.rowIndex="2" />
               <Button onAction="#escenaPaginaInicio" prefHeight="36.0" prefWidth="71.0" styleClass="boton-menu" stylesheets="@productosview.css" text="Buscar" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            </children>
         </GridPane>

            <HBox alignment="CENTER" spacing="20">
                <Button styleClass="boton-menu" stylesheets="@productosview.css" text="GUARDAR" />
                <Button styleClass="boton-menu" text="CANCELAR" />
            </HBox>
         <HBox alignment="CENTER" spacing="20">
            <children>
               <Button prefHeight="25.0" prefWidth="70.0" styleClass="boton-menu" stylesheets="@productosview.css" text="Siguiente" />
               <Button styleClass="boton-menu" text="Anterior" />
            </children>
         </HBox>
        </VBox>
    </center>
</BorderPane>
