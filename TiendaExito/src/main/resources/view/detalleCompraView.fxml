<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="950.0" stylesheets="@detallecompraview.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tiendaexito.controller.detalleCompraController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="111.0" spacing="15" styleClass="root1" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>
            <Button fx:id="btnNuevo" onAction="#agregarDetalleCompra" prefHeight="30.0" prefWidth="83.0" styleClass="boton-menu" text="NUEVO" />
            <Button fx:id="btnEditar" onAction="#editarDetalleCompra" prefHeight="30.0" prefWidth="84.0" styleClass="boton-menu" text="EDITAR" />
            <Button fx:id="btnEliminar" onAction="#cancelarDetalleCompra" prefHeight="33.0" prefWidth="80.0" styleClass="boton-menu" text="ELIMINAR" />
            <Button onAction="#escenaPaginaInicio" prefHeight="36.0" prefWidth="81.0" styleClass="boton-menu" stylesheets="@productosview.css" text="REGRESAR" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" prefHeight="576.0" prefWidth="681.0" spacing="15" styleClass="root" stylesheets="@productosview.css" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label styleClass="titulo" text="Detalle Compra" />

            <TableView fx:id="tablaDetalleCompras" maxHeight="200.0" maxWidth="800.0" prefHeight="200" prefWidth="800.0" styleClass="tabla-detalleCompra">
                <columns>
                    <TableColumn fx:id="colIdDetalle" prefWidth="133.33" text="ID" />
                    <TableColumn fx:id="colIdCompra" prefWidth="133.33" text="IDCompra" />
                    <TableColumn fx:id="colIdProducto" prefWidth="133.33" text="Producto" />
                    <TableColumn fx:id="colCantidad" prefWidth="133.33" text="Cantidad" />
               <TableColumn fx:id="colPrecioUnitario" prefWidth="133.33" text="PrecioUnitario" />
               <TableColumn fx:id="colSubtotal" prefWidth="135.0" text="SubTotal" />
                </columns>
            </TableView>
         <GridPane prefHeight="163.0" prefWidth="649.0">
           <columnConstraints>
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="125.0" minWidth="10.0" prefWidth="92.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="221.0" minWidth="10.0" prefWidth="182.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="204.0" minWidth="10.0" prefWidth="95.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="209.0" minWidth="10.0" prefWidth="83.0" />
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="192.0" minWidth="10.0" prefWidth="192.0" />
           </columnConstraints>
           <rowConstraints>
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
           </rowConstraints>
            <children>
               <Label text="ID" textAlignment="RIGHT" />
               <Label text="IDCOMPRA" textAlignment="RIGHT" GridPane.rowIndex="1" />
               <Label text="IDPRODUCTO" textAlignment="RIGHT" GridPane.rowIndex="2" />
               <Label text="CANTIDAD" textAlignment="RIGHT" GridPane.rowIndex="3" />
               <Label text="PRECIO UNITARIO" textAlignment="RIGHT" GridPane.columnIndex="3" />
               <Label text="SUBTOTAL" textAlignment="RIGHT" GridPane.columnIndex="3" GridPane.rowIndex="1" />
               <TextField fx:id="txtIdDetalle" disable="true" prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="1" />
               <TextField fx:id="txtCantidad" disable="true" prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <TextField fx:id="txtPrecioUnitario" disable="true" prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="4" />
               <TextField fx:id="txtSubtotal" disable="true" prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="4" GridPane.rowIndex="1" />
               <ComboBox fx:id="cmbIdCompra" disable="true" prefHeight="25.0" prefWidth="192.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <ComboBox fx:id="cmbIdProducto" disable="true" prefHeight="25.0" prefWidth="185.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <TextField fx:id="txtBuscar" prefHeight="25.0" prefWidth="157.0" GridPane.columnIndex="4" GridPane.rowIndex="2" />
               <Button fx:id="btnBuscar" onAction="#buscarDetalleCompra" prefHeight="36.0" prefWidth="71.0" styleClass="boton-menu" stylesheets="@productosview.css" text="Buscar" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            </children>
         </GridPane>

            <HBox alignment="CENTER" spacing="20" />
        </VBox>
    </center>
</BorderPane>
